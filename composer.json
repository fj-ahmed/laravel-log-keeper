{
    "name": "fj-ahmed/laravel-log-keeper",
    "description": "Laravel Log Keeper helps rotating you logs while storing them anywhere you want with custom local/remote retention policies",
    "keywords": ["laravel", "log", "s3", "retention", "dropbox", "ftp", "sftp", "rotation", "disk", "drive", "remote"],
    "autoload": {
        "psr-4": {
            "FjAhmed\\LaravelLogKeeper\\": "src/"
        }
    },
    "authors": [
        {
            "name": "FJ Ahmed",
            "email": "farhan@fyxify.com"
        }
    ],
    "require": {
        "php": "^7.4|^8.0",
        "ext-zip": "*",
        "illuminate/console": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "monolog/monolog": "^2.0|^3.0"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest"
    },
    "config": {
        "preferred-install": "dist"
    }
}
